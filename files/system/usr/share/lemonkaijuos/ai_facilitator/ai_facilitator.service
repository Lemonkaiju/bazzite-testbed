[Unit]
Description=AI Facilitator Server - Safety-First AI Command Server
Documentation=file:///home/LemonKaiju/projects/Linux testbed/ai_facilitator/README.md
After=network.target polkit.service

[Service]
Type=simple
User=%i
Group=%i
WorkingDirectory=/home/LemonKaiju/projects/Linux testbed/ai_facilitator
ExecStart=/usr/bin/python3 -m ai_facilitator.server
Restart=on-failure
RestartSec=10

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/%i/.local/share/ai_facilitator /home/%i/.config/ai_facilitator

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-facilitator

[Install]
WantedBy=default.target
